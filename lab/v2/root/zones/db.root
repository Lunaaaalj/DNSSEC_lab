; root/zones/db.root  (unsigned source; DS records are appended by 10-sign.sh)
$TTL 86400
@ IN SOA ns.root. admin.root. ( 2026112201 3600 900 604800 86400 )
@ IN NS ns.root.
ns.root. IN A 172.30.0.10
; Delegation to unsigned (insecure: no DS)
unsigned. IN NS ns.unsigned.
ns.unsigned. IN A 172.30.0.20
; Delegation to signed (secure: DS appended at signing time)
signed. IN NS ns.signed.
ns.signed. IN A 172.30.0.40
